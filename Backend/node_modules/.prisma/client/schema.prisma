// SQLite en attendant le choix définitif Postgres/MariaDB à 3 (cf TO-DO_backend.md)
// TODO migration Postgres : changer provider + url du datasource, repartir avec un historique
// de migrations neuf (le SQL de prisma/migrations/*.sql est specifique a SQLite),
// voir le TODO enum sur Friendship.status plus bas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int            @id @default(autoincrement())
  username               String         @unique
  email                  String         @unique
  password_hash          String?
  display_name           String
  avatar_url             String?
  is_online              Boolean        @default(false)
  last_seen_at           DateTime?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  oauthAccounts          OAuthAccount[]
  attempts               QuizAttempt[]
  sentFriendRequests     Friendship[]   @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]   @relation("FriendshipAddressee")
  blockedUsers           BlockedUser[]  @relation("BlockedUserBlocker")
  blockedByUsers         BlockedUser[]  @relation("BlockedUserBlocked")
  quizzes                Quiz[]         @relation("QuizOwner")
  questions              Question[]     @relation("QuestionAuthor")
}

model OAuthAccount {
  id               Int      @id @default(autoincrement())
  user_id          Int
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  provider         String
  provider_user_id String
  created_at       DateTime @default(now())

  @@unique([provider, provider_user_id])
}

model Friendship {
  id           Int      @id @default(autoincrement())
  requester_id Int
  requester    User     @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee_id Int
  addressee    User     @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)
  status       String   @default("pending") // TODO: passer en enum (pending/accepted/declined) quand on migre vers Postgres, pas supporte par Prisma sur SQLite
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([requester_id, addressee_id])
}

model BlockedUser {
  id         Int      @id @default(autoincrement())
  blocker_id Int
  blocker    User     @relation("BlockedUserBlocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id Int
  blocked    User     @relation("BlockedUserBlocked", fields: [blocked_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([blocker_id, blocked_id])
}

model Quiz {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())

  ownerId    Int?
  owner      User?  @relation("QuizOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  visibility String @default("public") // "public" | "friends" | "private"

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model Category {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String @unique

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id          Int      @id @default(autoincrement())
  ref         String?  @unique // "geo-001" pour la banque, null pour une question perso
  type        String   @default("multiple") // "multiple" | "boolean"
  difficulty  Int      @default(1) // 1 facile, 2 moyen, 3 difficile
  text        String
  explanation String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  authorId Int?
  author   User? @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  imageId Int?
  image   Image? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  tags             Tag[]
  answers          Answer[]
  quizzes          QuizQuestion[]
  attemptQuestions AttemptQuestion[]
  userAnswers      UserAnswer[]

  @@index([categoryId, difficulty])
}

model QuizQuestion {
  quizId     Int
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int

  @@id([quizId, questionId])
  @@unique([quizId, position])
}

model Answer {
  id        Int     @id @default(autoincrement())
  text      String?
  isCorrect Boolean @default(false)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  imageId Int?
  image   Image? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  userAnswers UserAnswer[]
}

model QuizAttempt {
  id             Int       @id @default(autoincrement())
  score          Int       @default(0)
  totalQuestions Int       @default(0)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  mode   String @default("limite")
  status String @default("in_progress")

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partie sur un quiz existant (null pour une partie générée)
  quizId Int?
  quiz   Quiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)

  // Partie générée : le score est rattaché à ce thème, pas à un quiz
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagId      Int?
  tag        Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)
  difficulty Int?

  questions   AttemptQuestion[]
  userAnswers UserAnswer[]

  @@index([userId])
  @@index([categoryId, tagId, difficulty])
  @@index([categoryId, difficulty, mode, status])
}

model AttemptQuestion {
  attemptId  Int
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int

  @@id([attemptId, questionId])
  @@unique([attemptId, position])
}

model UserAnswer {
  id        Int     @id @default(autoincrement())
  isCorrect Boolean

  attemptId Int
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerId Int?
  answer   Answer? @relation(fields: [answerId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
}

model Image {
  id            Int     @id @default(autoincrement())
  src           String  @unique
  alt           String
  creditAuthor  String?
  creditLicense String?
  creditUrl     String?

  questions Question[]
  answers   Answer[]
}

model Tag {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  questions Question[]
  attempts  QuizAttempt[]
}
