# --- Serveur ---
PORT=3000

# --- Base de données ---
# SQLite temporaire en attendant le choix définitif Postgres/MariaDB à 3
DATABASE_URL="file:./dev.db"

# --- Authentification / Session ---
# TODO: à définir une fois la stratégie retenue (JWT ou cookie de session)
JWT_SECRET= #généré avec openssl rand -hex 32

# --- OAuth 2.0 ---
# TODO: à remplir une fois le fournisseur OAuth choisi (ex: API 42, Google...)
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret
# OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- HTTPS ---
SSL_CERT_PATH=./
SSL_KEY_PATH=./

# --- Front (CORS) ---
FRONTEND_URL=
