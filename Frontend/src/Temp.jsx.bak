  const [name, setName] = useState("");
  const [submitted,setSubmitted] = useState(false);

  function handleChange(e) {
    setName(e.target.value);
  }

  function handleSubmit(e) {
    e.preventDefault();
    setSubmitted(true);
    ApiSend({name});
  }

function MyForm({ name, onChange, onSubmit }) {
  return (
    <form onSubmit={onSubmit}>
      <label>
        vos papiers svp :
        <input type="text" value={name} onChange={onChange} />
      </label>
    </form>
  );
}

function Bonjour({name}) {
  return  <p>Bonjour, {name} !</p>;
}

function Counter() {
  let [count, setCount] = useState(0);

  return (
    <div>
      <button onClick={() => setCount(count + 1)} className={styles.button}>
        le bouton
      </button>
    <p> Tu as click {(count) < 10 ? count : "trop de"} fois.</p>
    
    </div>
  );
}

function GetRequest(){
  const [msg, setMsg] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    fetch('http://localhost:3000/api/getrequest')
      .then(res => res.json())
      .then(data => {
        setMsg(data);
        setLoading(false);
      })
      .catch(err => {
        setError(err.message);
        setLoading(false);
      });
  }, []);

  if(loading) return (
    <>
      <p>Get Query:</p>
      <p>Loading...</p>
    </>
  )
  if (error) return <p>Error : {error}</p>;

  return (
    <>
    <p>Get Query:</p>
    <ul style={{textAlign: "left"}}>
      {msg.map (u => <li key={u.nom}>{u.nom} {u.age}</li>)}
    </ul>
    </>
  )
}

function PostRequest(){
  const [msg, setMsg] = useState([]);
  const [loading,setLoading] = useState(true);

  useEffect(() => {
    fetch('http://localhost:3000/api/postrequest', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({
        id: 1,
        message: "Bonjour je suis une post request",
        test: "salut"
      }),
    })
    .then (res=>res.json())
    .then(data => {
      setMsg(data);
      setLoading(false)
    });
  }, []); // Tableau de dependances (sets how it updates [] = once, mais ya d'autres options)

  if(loading) return (
    <>
      <p>Post Query:</p>
      <p>Loading...</p>
    </>
  )

  return(
    <>
    <p>Post Query:</p>
    <ul>
      {msg.map (u=> <li key={u.id}>[{u.message}] [{u.test}]</li>)}
    </ul>
    </>
  )
};

function ApiSend({name}){
  console.log("sending :", name);
}

